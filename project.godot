; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Echo Location"
config/description="靠声呐脉冲在黑暗中探路的小游戏"
run/main_scene="res://scenes/Level01.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Boot="*res://autoload/boot.gd"
GameLog="*res://autoload/game_log.gd"

[display]

window/stretch/mode="canvas_items"

[rendering]

environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
